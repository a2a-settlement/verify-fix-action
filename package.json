{
  "name": "verify-fix-action",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action that asks SettleBridge to verify a security-advisory fix and publishes the verdict.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "lint": "eslint . && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@actions/artifact": "^2.3.2",
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^20.17.0",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^9.28.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  }
}
